DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/leps?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:5173"
LICENSE_BINDING_SECRET="replace-with-a-different-long-random-secret-at-least-32-chars"
LICENSE_SIGNING_PRIVATE_KEY="base64-encoded-pkcs8-ed25519-private-key"
LICENSE_SIGNING_PUBLIC_KEY="base64-encoded-spki-ed25519-public-key"
ADMIN_EMAIL="admin@leps.local"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="replace-with-a-password-at-least-8-chars"

# Isolated database for `bun run db:verify:test`; its name must end in `_test`.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/leps_test?schema=public"

# Production example; use the provider's pooled/serverless endpoint:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
#
# Vercel Redis/KV integration usually creates these:
# KV_REST_API_URL="https://..."
# KV_REST_API_TOKEN="..."
#
# Upstash Redis direct setup can also use these:
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
#
# Generate one fresh matching Ed25519 pair locally; copy both values to this file.
# bun -e "const c=require('node:crypto');const k=c.generateKeyPairSync('ed25519');console.log('LICENSE_SIGNING_PRIVATE_KEY='+k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('LICENSE_SIGNING_PUBLIC_KEY='+k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
