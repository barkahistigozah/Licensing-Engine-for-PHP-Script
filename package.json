{
  "name": "leps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "effect": "3.20.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "bun run db:generate && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check README.md README.id.md package.json playwright.config.ts prisma/seed.ts src svelte.config.js vite.config.ts",
    "postinstall": "bun run db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:verify:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-test-db.ps1",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.23",
    "@elysia/eden": "1.4.10",
    "@prisma/client": "6.19.0",
    "better-auth": "1.6.23",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1",
    "prisma": "6.19.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
